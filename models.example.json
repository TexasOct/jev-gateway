{
  "gateway": {
    "session_ttl_seconds": 7200
  },
  "storage": {
    "enabled": true
  },
  "jev": {
    "enabled": false,
    "timeout_seconds": 5,
    "sources": [
      {
        "id": "openrouter",
        "api_base": "https://openrouter.ai/api/v1/systemone",
        "api_key_env": "JEV_OPENROUTER_API_KEY",
        "model": "typesafe/jev-1.13"
      }
    ]
  },
  "signals": {
    "patterns_enabled": false,
    "intent_patterns_enabled": true
  },
  "strategies": {
    "quality": {
      "mode": "cached",
      "selection": "quality_first",
      "labels": {
        "routine": {
          "score": 0,
          "description": "Routine answers",
          "reasoning_effort": "low"
        },
        "analysis": {
          "score": 0.35,
          "description": "Multi-step analysis",
          "reasoning_effort": "medium"
        },
        "critical": {
          "score": 0.65,
          "description": "Critical architecture and audits",
          "reasoning_effort": "high"
        }
      }
    },
    "economy": {
      "mode": "cached",
      "selection": "cheapest_adequate",
      "labels": {
        "budget": {
          "score": 0,
          "description": "Low-cost short requests",
          "reasoning_effort": "low"
        },
        "extended": {
          "score": 0.35,
          "description": "Low-cost multi-step requests",
          "reasoning_effort": "medium"
        },
        "exception": {
          "score": 0.65,
          "description": "Complex work with a cost-aware pool",
          "reasoning_effort": "high"
        }
      }
    },
    "task_aware": {
      "kind": "jev_matrix",
      "mode": "fresh",
      "description": "Routes docs and small edits to a small model, while coding and reverse-engineering use the top model with a higher thinking level.",
      "reasoning": {
        "mode": "override",
        "effort_by_label": {
          "draft": "low",
          "review": "medium",
          "engineering": "high"
        }
      },
      "options": {
        "questions": {
          "workload": {
            "type": "choice",
            "instructions": "What is the main kind of work this request asks for?",
            "criteria": {
              "docs": "Documentation, comments, prose, translation, or summarization; no code behavior changes.",
              "small_change": "A narrow, bounded code or config change: a rename, dependency bump, formatting pass, or single-file tweak.",
              "coding": "Implement, fix, or refactor behavior in code; the change has to work.",
              "reverse": "Understand, audit, or reverse-engineer existing code or systems: architecture, protocol or binary analysis, security review, or hard debugging."
            }
          },
          "rigor": {
            "type": "choice",
            "instructions": "How exact does the output need to be?",
            "criteria": {
              "draft": "A first pass is fine; it will be reviewed or reworked.",
              "exacting": "It ships or gates other work: an interface, migration, security boundary, or release."
            }
          }
        },
        "rules": [
          {
            "when": {
              "workload": "reverse"
            },
            "select": {
              "selection": "quality_first",
              "label": "engineering"
            }
          },
          {
            "when": {
              "workload": "coding"
            },
            "select": {
              "selection": "quality_first",
              "label": "engineering"
            }
          },
          {
            "when": {
              "workload": [
                "docs",
                "small_change"
              ],
              "rigor": "exacting"
            },
            "select": {
              "selection": "balanced",
              "label": "review"
            }
          },
          {
            "when": {
              "workload": [
                "docs",
                "small_change"
              ]
            },
            "select": {
              "selection": "cheapest_adequate",
              "label": "draft"
            }
          }
        ],
        "fallback": {
          "selection": "balanced",
          "label": "review"
        }
      },
      "labels": {
        "draft": {
          "score": 0,
          "description": "Documentation drafts and bounded edits",
          "reasoning_effort": "low"
        },
        "review": {
          "score": 0.35,
          "description": "Exacting review",
          "reasoning_effort": "medium"
        },
        "engineering": {
          "score": 0.65,
          "description": "Coding and reverse engineering",
          "reasoning_effort": "high"
        }
      }
    }
  },
  "providers": [
    {
      "id": "deepseek",
      "type": "deepseek",
      "api_base": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    {
      "id": "openai",
      "type": "openai",
      "api_base": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY"
    }
  ],
  "policy": {
    "mode": "sticky",
    "selection": "balanced",
    "pin": {
      "break_on": [
        "capability_gap",
        "context_pressure",
        "output_limit"
      ]
    },
    "reasoning": {
      "mode": "override",
      "on_reasoning_request": "high",
      "on_user_correction": "high",
      "fallback": "medium",
      "effort_by_label": {
        "quick": "low",
        "working": "medium",
        "deep": "high"
      }
    },
    "labels": {
      "quick": {
        "score": 0,
        "description": "Short bounded tasks",
        "reasoning_effort": "low"
      },
      "working": {
        "score": 0.35,
        "description": "Multi-step tasks",
        "reasoning_effort": "medium"
      },
      "deep": {
        "score": 0.65,
        "description": "Architecture and deep reasoning",
        "reasoning_effort": "high"
      }
    }
  },
  "models": [
    {
      "provider": "deepseek",
      "upstream_model": "deepseek-flash",
      "priority": 10,
      "quality": 0.6,
      "context_window": 1000000,
      "max_output_tokens": 384000,
      "capabilities": {
        "reasoning": true,
        "reasoning_effort": [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      "cost": {
        "input_per_million": 0.3,
        "output_per_million": 1.2
      },
      "tags": [
        "default/quick",
        "default/working",
        "economy/budget",
        "economy/extended",
        "economy/exception",
        "task_aware/draft"
      ]
    },
    {
      "provider": "openai",
      "upstream_model": "gpt-5.6-sol",
      "priority": 20,
      "quality": 0.95,
      "context_window": 1000000,
      "max_output_tokens": 128000,
      "capabilities": {
        "reasoning": true,
        "temperature": false,
        "reasoning_effort": [
          "none",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      "cost": {
        "input_per_million": 2.0,
        "output_per_million": 10.0
      },
      "tags": [
        "default/deep",
        "quality/critical",
        "economy/exception",
        "task_aware/engineering"
      ]
    },
    {
      "provider": "openai",
      "upstream_model": "gpt-5.6-luna",
      "priority": 10,
      "context_window": 1000000,
      "max_output_tokens": 128000,
      "capabilities": {
        "reasoning": true,
        "temperature": false,
        "reasoning_effort": [
          "none",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      "cost": {
        "input_per_million": 1.0,
        "output_per_million": 5.0
      },
      "tags": [
        "default/quick",
        "quality/routine"
      ]
    },
    {
      "provider": "openai",
      "upstream_model": "gpt-5.6-terra",
      "priority": 20,
      "quality": 0.75,
      "context_window": 1000000,
      "max_output_tokens": 128000,
      "capabilities": {
        "reasoning": true,
        "temperature": false,
        "reasoning_effort": [
          "none",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      "cost": {
        "input_per_million": 0.75,
        "output_per_million": 7.5
      },
      "tags": [
        "default/working",
        "quality/analysis",
        "task_aware/review"
      ]
    }
  ]
}
