{
  "gateway": {
    "session_ttl_seconds": 7200,
    "log_format": "pretty"
  },
  "storage": {
    "enabled": true,
    "max_continuations_per_session": 40,
    "max_continuation_sessions": 2048
  },
  "decision": {
    "enabled": false,
    "timeout_seconds": 5,
    "providers": [
      {
        "id": "decision-example",
        "protocol": "system_one",
        "api_base": "https://decision.example/v1/evaluate",
        "api_key_env": "DECISION_API_KEY"
      }
    ]
  },
  "signals": {
    "patterns_enabled": false,
    "intent_patterns_enabled": true
  },
  "strategies": {
    "task_aware": {
      "kind": "jev_matrix",
      "mode": "fresh",
      "description": "Routes by purpose and scale: research, documentation, review, and bounded coding run on DeepSeek, shippable small and mid-size coding runs on Luna, large coding and reverse engineering run on Sol, and only cross-domain ultra-complex work reaches the reserved ultra tier.",
      "reasoning": {
        "mode": "override",
        "effort_by_label": {
          "draft": "low",
          "review": "medium",
          "craft": "medium",
          "engineering": "high",
          "ultra": "xhigh"
        }
      },
      "options": {
        "questions": {
          "workload": {
            "type": "choice",
            "instructions": "What is the main kind of work this request asks for?",
            "criteria": {
              "research": "Investigate, search, read, or summarise existing material: looking things up, reading code or documents, comparing options, or gathering evidence. It produces understanding, not a behaviour change.",
              "docs": "Write or edit documentation, comments, prose, translations, or release notes.",
              "small_change": "A narrow, bounded change: a rename, dependency bump, formatting pass, config tweak, or single-file edit.",
              "coding": "Implement, fix, or refactor behaviour in code; the change has to work.",
              "reverse": "Understand, audit, or reverse-engineer existing code or systems: architecture, protocol or binary analysis, security review, or hard debugging."
            }
          },
          "scale": {
            "type": "choice",
            "instructions": "How large and self-contained is the work?",
            "criteria": {
              "bounded": "One file or one spot with clear edges; it can be finished in a single short pass.",
              "moderate": "Several files or steps, but the path is clear: small to mid-sized work.",
              "large": "Cross-module or long-horizon work that needs architecture judgement, sustained autonomous execution, or repeated experimentation.",
              "cross_domain": "The request needs several independent high-difficulty professional domains at once, such as 3D modelling together with circuit design, or coupled mechanical, electromagnetic, and thermal engineering. A single hard domain is not this."
            }
          },
          "rigor": {
            "type": "choice",
            "instructions": "How exact does the output need to be?",
            "criteria": {
              "draft": "A first pass is fine; it will be reviewed or reworked.",
              "exacting": "It ships or gates other work: an interface, migration, security boundary, or release."
            }
          }
        },
        "rules": [
          {
            "when": {
              "scale": "cross_domain",
              "workload": [
                "coding",
                "reverse"
              ]
            },
            "select": {
              "selection": "quality_first",
              "label": "ultra"
            }
          },
          {
            "when": {
              "workload": "reverse"
            },
            "select": {
              "selection": "quality_first",
              "label": "engineering"
            }
          },
          {
            "when": {
              "workload": "coding",
              "scale": "large"
            },
            "select": {
              "selection": "quality_first",
              "label": "engineering"
            }
          },
          {
            "when": {
              "workload": "coding",
              "rigor": "exacting"
            },
            "select": {
              "selection": "cheapest_adequate",
              "label": "craft"
            }
          },
          {
            "when": {
              "workload": "coding"
            },
            "select": {
              "selection": "cheapest_adequate",
              "label": "draft"
            }
          },
          {
            "when": {
              "workload": [
                "research",
                "docs",
                "small_change"
              ],
              "rigor": "exacting"
            },
            "select": {
              "selection": "cheapest_adequate",
              "label": "review"
            }
          },
          {
            "when": {
              "workload": [
                "research",
                "docs",
                "small_change"
              ]
            },
            "select": {
              "selection": "cheapest_adequate",
              "label": "draft"
            }
          }
        ],
        "fallback": {
          "selection": "cheapest_adequate",
          "label": "review"
        }
      },
      "labels": {
        "draft": {
          "score": 0,
          "description": "Research, documentation, bounded edits, and quick coding passes",
          "reasoning_effort": "low"
        },
        "review": {
          "score": 0.25,
          "description": "Exacting research, documentation, and bounded edits",
          "reasoning_effort": "medium"
        },
        "craft": {
          "score": 0.45,
          "description": "Shippable small and mid-sized coding",
          "reasoning_effort": "medium"
        },
        "engineering": {
          "score": 0.65,
          "description": "Large coding and reverse engineering",
          "reasoning_effort": "high"
        },
        "ultra": {
          "score": 0.85,
          "description": "Cross-domain ultra-complex work reserved for the top tier",
          "reasoning_effort": "xhigh"
        }
      }
    },
    "quality": {
      "mode": "cached",
      "selection": "quality_first",
      "labels": {
        "routine": {
          "score": 0,
          "description": "Routine answers",
          "reasoning_effort": "low"
        },
        "analysis": {
          "score": 0.35,
          "description": "Multi-step analysis",
          "reasoning_effort": "medium"
        },
        "critical": {
          "score": 0.65,
          "description": "Critical architecture and audits",
          "reasoning_effort": "high"
        }
      }
    },
    "economy": {
      "mode": "cached",
      "selection": "cheapest_adequate",
      "labels": {
        "budget": {
          "score": 0,
          "description": "Low-cost short requests",
          "reasoning_effort": "low"
        },
        "extended": {
          "score": 0.35,
          "description": "Low-cost multi-step requests",
          "reasoning_effort": "medium"
        },
        "exception": {
          "score": 0.65,
          "description": "Complex work with a cost-aware pool",
          "reasoning_effort": "high"
        }
      }
    }
  },
  "providers": [
    {
      "id": "deepseek",
      "type": "deepseek",
      "api_base": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    {
      "id": "openai",
      "type": "openai",
      "api_base": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY"
    }
  ],
  "policy": {
    "mode": "sticky",
    "selection": "balanced",
    "pin": {
      "break_on": [
        "capability_gap",
        "context_pressure",
        "output_limit"
      ]
    },
    "reasoning": {
      "mode": "override",
      "on_reasoning_request": "high",
      "on_user_correction": "high",
      "fallback": "medium",
      "effort_by_label": {
        "quick": "low",
        "working": "medium",
        "deep": "high"
      }
    },
    "labels": {
      "quick": {
        "score": 0,
        "description": "Short bounded tasks",
        "reasoning_effort": "low"
      },
      "working": {
        "score": 0.35,
        "description": "Multi-step tasks",
        "reasoning_effort": "medium"
      },
      "deep": {
        "score": 0.65,
        "description": "Architecture and deep reasoning",
        "reasoning_effort": "high"
      }
    }
  },
  "models": [
    {
      "provider": "deepseek",
      "upstream_model": "deepseek-flash",
      "priority": 10,
      "quality": 0.6,
      "context_window": 1000000,
      "max_output_tokens": 384000,
      "capabilities": {
        "reasoning": true,
        "reasoning_effort": [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      "cost": {
        "input_per_million": 0.29643682931167364,
        "output_per_million": 1.1857473172466946
      },
      "tags": [
        "economy/budget",
        "economy/extended",
        "economy/exception",
        "task_aware/draft",
        "task_aware/review"
      ]
    },
    {
      "provider": "openai",
      "upstream_model": "gpt-5.6-terra",
      "priority": 20,
      "quality": 0.75,
      "context_window": 1000000,
      "max_output_tokens": 128000,
      "capabilities": {
        "reasoning": true,
        "temperature": false,
        "reasoning_effort": [
          "none",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      "cost": {
        "input_per_million": 0.75,
        "output_per_million": 7.5
      },
      "tags": [
        "quality/analysis"
      ]
    },
    {
      "provider": "openai",
      "upstream_model": "gpt-6-astra",
      "priority": 5,
      "quality": 1.0,
      "context_window": 1050000,
      "max_output_tokens": 128000,
      "capabilities": {
        "reasoning": true,
        "temperature": false,
        "reasoning_effort": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      "cost": {
        "input_per_million": 10.0,
        "output_per_million": 50.0
      },
      "tags": [
        "task_aware/ultra"
      ]
    },
    {
      "provider": "openai",
